    "\"%@ %@\" has no associated data and will be permanently removed." : {
      "comment" : "A message that appears when a user confirms deleting a property that has no associated data.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@ %2$@\" nemá žádná přidružená data a bude trvale odstraněna."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\"%1$@ %2$@\" has no associated data and will be permanently removed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@ %2$@\" no tiene datos asociados y se eliminará permanentemente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@ %2$@\" n'a aucune donnée associée et sera définitivement supprimée."
          }
        }
      }
    },
    "\"%@ %@\" will be permanently deleted along with %@." : {
      "comment" : "A message that informs the user that a property will be deleted along with some of its associated data. The first argument is the name of the property. The second argument is a list of the names of some of the property's associated data items, joined by commas.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@ %2$@\" bude trvale odstraněna spolu s %3$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\"%1$@ %2$@\" will be permanently deleted along with %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@ %2$@\" se eliminará permanentemente junto con %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@ %2$@\" sera définitivement supprimée avec %3$@."
          }
        }
