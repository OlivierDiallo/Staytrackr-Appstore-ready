      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@ %@  ·  %lld night%@" : {
      "comment" : "A sublabel within a booking row that shows the name of the property and the number of nights the booking spans. The first argument is the emoji representation of the property. The second argument is the name of the property. The third argument is the number of nights as a string.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@  ·  %3$lld night%4$@"
          }
        }
      }
    },
    "%@ → %@" : {
      "comment" : "A pair of text elements displaying the check-in and check-out dates for a booking, separated by a right arrow, followed by the total cost of the booking in a specified currency. The first and second elements use the \"abbreviated\" date and time formats, respectively.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ → %2$@"
          }
        }
      }
    },
    "%lld" : {
      "comment" : "The day number displayed in the calendar view.",
      "isCommentAutoGenerated" : true
    },
