    "Notifications fire at 9 AM on the selected day. \"Morning of\" sends the alert on the day of arrival or departure." : {
      "comment" : "A footer for the \"Notifications\" section that explains how notifications work.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifikace jsou odesílány v 9:00 vybraný den. „Ráno příjezdu“ odešle upozornění v den příjezdu nebo odjezdu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones se envían a las 9:00 el día seleccionado. «La mañana de» envía la alerta el día de llegada o salida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notifications sont envoyées à 9h le jour sélectionné. « Le matin même » envoie l'alerte le jour de l'arrivée ou du départ."
          }
        }
      }
    },
